# Copy to .env and adjust as needed
# Host for the FastAPI server.
HOST=127.0.0.1
# Port for the FastAPI server.
PORT=8091
# Log level for application startup.
LOG_LEVEL=INFO
# Directory where the durable queue stores items and the dedup database.
STATE_DIR=./state
# Days to keep delivered items in sent/ before cleanup.
QUEUE_SENT_RETENTION_DAYS=30
# Days to keep failed items in failed/ before final cleanup.
QUEUE_FAILED_RETENTION_DAYS=30
# Minute precision used to compute SMS content hash; messages within the same minute with same number and text are deduplicated.
DEDUP_WINDOW_MINUTES=1

# Copy to .env and adjust as needed
# Host for the FastAPI server.
HOST=127.0.0.1
# Port for the FastAPI server.
PORT=8091
# Log level for application startup.
LOG_LEVEL=INFO
# Directory where the durable queue stores items and the dedup database.
STATE_DIR=./state
# Days to keep delivered items in sent/ before cleanup.
QUEUE_SENT_RETENTION_DAYS=30
# Days to keep failed items in failed/ before final cleanup.
QUEUE_FAILED_RETENTION_DAYS=30
# Minute precision used to compute SMS content hash; messages within the same minute with same number and text are deduplicated.
DEDUP_WINDOW_MINUTES=1
# Bot token from BotFather.
TELEGRAM_BOT_TOKEN=
# Numeric chat ID where SMS forwards are delivered; can be negative for groups.
TELEGRAM_CHAT_ID=
# Override only for testing or proxy.
TELEGRAM_API_BASE=https://api.telegram.org
# HTTP timeout per request to Telegram API.
TELEGRAM_TIMEOUT_SECONDS=10
# Max attempts per send_message call before giving up.
TELEGRAM_MAX_RETRIES=3
# Backoff schedule in seconds for delivery retries; scheduled retries equal length of this list.
WORKER_RETRY_SCHEDULE_SECONDS=5,30,300,1800,7200,21600,86400
# URL path where Prometheus scrapes metrics.
METRICS_PATH=/metrics
# Set to true to start the SMS-to-Telegram relay on app startup; false keeps the app modem-free for tests.
RELAY_ENABLED=false
# Interval in seconds for the queue gauge updater that scans state subdirectories and sets queue_*_count gauges.
QUEUE_GAUGE_INTERVAL_SECONDS=30

[Unit]
Description=Enable USB modem after ModemManager is ready
After=ModemManager.service
Wants=ModemManager.service
PartOf=ModemManager.service
ConditionPathExists=/usr/bin/mmcli

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/sleep 10
ExecStart=/usr/local/sbin/sms-gateway-modem-enable.sh

[Install]
WantedBy=multi-user.target
